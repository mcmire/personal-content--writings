{
  "settings_version": "0.20.0",
  "debug": false,
  "obsidian_command_palette_prefix": "Execute: ",
  "preview_variables_in_command_palette": true,
  "show_autocomplete_menu": true,
  "working_directory": "",
  "default_shells": {},
  "environment_variable_path_augmentations": {
    "darwin": "/opt/homebrew/bin:~/.bin:{{!environment:PATH}}"
  },
  "error_message_duration": 20,
  "notification_message_duration": 10,
  "execution_notification_mode": "disabled",
  "output_channel_clipboard_also_outputs_to_notification": true,
  "output_channel_notification_decorates_output": true,
  "enable_events": true,
  "approve_modals_by_pressing_enter_key": true,
  "command_palette": {
    "re_execute_last_shell_command": {
      "enabled": true,
      "prefix": "Re-execute: "
    }
  },
  "max_visible_lines_in_shell_command_fields": false,
  "shell_commands": [
    {
      "id": "ue04ce3hol",
      "platform_specific_commands": {
        "default": "~/.bin/sync-obsidian-from-obsidian-automatically"
      },
      "shells": {},
      "alias": "Sync with Git (automatically)",
      "icon": null,
      "confirm_execution": false,
      "ignore_error_codes": [],
      "input_contents": {
        "stdin": null
      },
      "output_handlers": {
        "stdout": {
          "handler": "notification",
          "convert_ansi_code": true
        },
        "stderr": {
          "handler": "notification",
          "convert_ansi_code": true
        }
      },
      "output_wrappers": {
        "stdout": null,
        "stderr": null
      },
      "output_channel_order": "stderr-first",
      "output_handling_mode": "buffered",
      "events": {
        "every-n-seconds": {
          "enabled": true,
          "seconds": 86400
        },
        "file-content-modified": {
          "enabled": true
        },
        "file-created": {
          "enabled": true
        },
        "file-deleted": {
          "enabled": true
        },
        "file-moved": {
          "enabled": true
        },
        "file-renamed": {
          "enabled": true
        }
      },
      "command_palette_availability": "enabled",
      "preactions": [],
      "variable_default_values": {}
    },
    {
      "id": "642aal41ie",
      "platform_specific_commands": {
        "default": "~/.bin/sync-obsidian-from-obsidian-manually"
      },
      "shells": {},
      "alias": "Sync with Git (manually)",
      "icon": null,
      "confirm_execution": false,
      "ignore_error_codes": [],
      "input_contents": {
        "stdin": null
      },
      "output_handlers": {
        "stdout": {
          "handler": "notification",
          "convert_ansi_code": true
        },
        "stderr": {
          "handler": "notification",
          "convert_ansi_code": true
        }
      },
      "output_wrappers": {
        "stdout": null,
        "stderr": null
      },
      "output_channel_order": "stdout-first",
      "output_handling_mode": "buffered",
      "events": {},
      "command_palette_availability": "enabled",
      "preactions": [],
      "variable_default_values": {}
    }
  ],
  "prompts": [],
  "builtin_variables": {},
  "custom_variables": [],
  "custom_shells": [],
  "output_wrappers": []
}